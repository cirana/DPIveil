{
  "name": "Default",
  "description": "Automatically probe Discord HTTPS and apply the selected strategy to Discord services.",
  "dns_policy": {
    "enabled": true,
    "resolver": "1.1.1.1",
    "doh_template": "https://cloudflare-dns.com/dns-query",
    "allow_fallback_to_udp": false
  },
  "filter": "(outbound and tcp and tcp.DstPort == 443) or (outbound and udp and udp.DstPort == 443) or (inbound and tcp and tcp.SrcPort == 443 and (tcp.Syn or tcp.Rst))",
  "strategy": "auto",
  "strategy_options": {
    "host": "discord.com",
    "timeout": 6,
    "candidate_timeout": 4,
    "max_ips": 2,
    "candidates": [
      {
        "name": "multisplit-2",
        "kind": "multisplit",
        "priority": 1,
        "split_pos": 2
      },
      {
        "name": "multidisorder-2",
        "kind": "multidisorder",
        "priority": 2,
        "split_pos": 2
      },
      {
        "name": "fake-ttl-1",
        "kind": "fake_ttl",
        "priority": 3,
        "ttl": 1
      },
      {
        "name": "fake+badseq",
        "kind": "fake+badseq",
        "priority": 4,
        "badseq_increment": -10000,
        "badack_increment": -66000
      },
      {
        "name": "syndata",
        "kind": "syndata",
        "priority": 5
      },
      {
        "name": "ipfrag2-8",
        "kind": "ipfrag2-8",
        "priority": 6,
        "ipfrag_pos": 8,
        "transport": "udp"
      }
    ]
  }
}
